{
  "expo": {
    "name": "E&T Live",
    "slug": "et-live-auctions-clean",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.etelectronics.etliveclean",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "ios": { "supportsTablet": true, "infoPlist": { "NSCameraUsageDescription": "E&T Live uses your camera to broadcast live auctions.", "NSMicrophoneUsageDescription": "E&T Live uses your microphone during live auctions." } },
    "web": { "bundler": "metro" },
    "plugins": ["@livekit/react-native-expo-plugin", "@config-plugins/react-native-webrtc"]
  }
}
